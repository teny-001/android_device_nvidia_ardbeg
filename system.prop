ro.opengles.version = 196609
#ro.sf.override_null_lcd_density = 1
#persist.sys.display.resolution = 1920x1080
hwcomposer.compositor=glcomposer
wifi.interface=wlan0
ap.interface=wlan0
persist.tegra.nvmmlite = 1
persist.wlan.ti.calibrated = 0
ro.sf.override_lcd_density = 1
# ============================================================================
# [TV 模式 2026-10-28] ro.sf.lcd_density 从 320 改成 240
#   屏幕物理分辨率 1920x1200（device.mk: TARGET_SCREEN_WIDTH/HEIGHT）。
#   320 是这块 8 寸屏的平板原生密度，坐在桌前看没问题；
#   但 TV 模式的观看距离通常 2 米以上，320 下的字和控件都太小。
#   240 让 UI 整体放大约 33%，是 1920 宽下比较稳妥的一档
#   （再往下 160 会让部分应用的多列布局退化成单列，Trebuchet 图标也会过大）。
#
#   想回平板模式就把 240 改回 320，改完 make installclean 重编即可，
#   不需要动别的文件。
#
#   注意：density 变了以后，已装的第三方应用可能缓存了旧的资源选择结果，
#   刷完建议 wipe data（eng 版本第一次刷机本来就该 wipe）。
# ============================================================================
ro.sf.lcd_density = 240

# NFC
debug.nfc.fw_download=false
debug.nfc.se=false

# use glcomposer as the default compositor
persist.tegra.compositor=glcomposer

# disable input resampling
ro.input.noresample=1
ro.com.google.clientidbase=android-nvidia

# don't preload OpenGL in Zygote, the Tegra drivers do not like it
ro.zygote.disable_gl_preload=true

pbc.enabled=0
pbc.log=0
pbc.board_power_threshold=20000
pbc.low_polling_freq_threshold=1000
pbc.rails=cpu,core,dram,gpu
pbc.cpu.power=/sys/bus/i2c/devices/7-0045/power1_input
pbc.cpu.cap=/dev/cpu_freq_max
pbc.cpu.cap.af=/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
pbc.core.power=/sys/bus/i2c/devices/7-0043/power1_input
pbc.dram.power=/sys/bus/i2c/devices/7-0049/power1_input
pbc.gpu.power=/sys/bus/i2c/devices/7-004b/power1_input
pbc.gpu.cap=/dev/gpu_freq_max
pbc.gpu.cap.af=/sys/devices/platform/host1x/gk20a.0/devfreq/gk20a.0/available_frequencies
persist.tegra.didim.enable = 1
persist.tegra.didim.video = 5
persist.tegra.didim.normal = 3
# ============================================================================
# [修复 2026-10-28] 这里原来是 persist.sys.usb.config=mtp，会把 adb 关掉。
#   原因：system.prop 的内容是「追加」到 build.prop 末尾的，属性加载时
#   后写的覆盖先写的，所以这一行会盖掉 device.mk 里
#       PRODUCT_PROPERTY_OVERRIDES += persist.sys.usb.config=mtp,adb
#   结果就是插上 USB 只有 MTP，adbd 根本不起 —— 刷了包也连不上 adb。
#   改成 mtp,adb，和 device.mk 保持一致。
# ============================================================================
persist.sys.usb.config=mtp,adb
persist.sys.isUsbOtgEnabled=1

ro.hardware.sensors=default.api_v1.3.mpl520.nvs

# usb vendor and product ID definition
ro.nv.usb.vid = 0955
ro.nv.usb.pid.mtp = 7102
ro.nv.usb.pid.mtp.adb = 7100
ro.nv.usb.pid.rndis = 7103
ro.nv.usb.pid.rndis.adb = 7103
ro.nv.usb.pid.ptp = 7102
ro.nv.usb.pid.ptp.adb = 7100

#mircast option in power menu
miracast.powermenu = 1

# Audio
ro.bt.bdaddr_path=/mnt/factory/bluetooth/bt_mac.txt
ro.hardware.audio.primary=tegra

# Widevine drm
drm.service.enabled=true

ro.product.model=ardbeg
ro.product.device=ardbeg

# Zygote
ro.zygote.preload.enable=0

ro.config.use_zygote_preload=false

ro.zygote.usap_pool_enabled=false
ro.zygote.usap_supported=false
#ro.boot.selinux=disable

# otaupdate
ro.radio.noril=true

# [修改 2026-10-28] 注释掉 ro.build.characteristics=tablet（TV 模式改造）
# 本文件是 TARGET_SYSTEM_PROP，内容被逐字追加到 build.prop，所以这里原本会让
# build.prop 同时出现 "tv"（buildinfo.sh 从 PRODUCT_CHARACTERISTICS 生成，在前）
# 和 "tablet"（这一行，在后）两行互相矛盾的声明。init 对 ro.* 只允许设置一次，
# 实际生效的是先出现的 tv，功能上没问题，但语义脆弱且容易误读。
# 现在只保留 lineage.mk 里的 PRODUCT_CHARACTERISTICS := tv 这一个来源。
# 详细分析见 ardbeg-work/编译与验证指南.md 的「TV 模式」一节。
#ro.build.characteristics=tablet
persist.sys.language=zh
persist.sys.country=CN
persist.sys.timezone=Asia/Shanghai
ro.product.locale.language=zh
ro.product.locale.region=CN

# ============================================================================
# 【2026-11-06 巡检新增】放大 logd 环形缓冲区 256K -> 16M
# ============================================================================
#   原因：原厂 4.4.4 的 hwcomposer.tegra.so 里有个 propmonitor_thread，
#   会以约 11.5 条/秒 的速度刷这条 Info 日志：
#       hwcomposer: propmonitor_thread: process event IN_CLOSE_NOWRITE
#                   overscan_rate:0 overscan_cur=0; overscanvalue:0, isoverscan:0
#   实测 2 秒 23 条、约 100 万条/天。
#
#   默认 256KB 的 main 缓冲区在这种刷屏下只能存 1 分钟不到的历史，
#   做任何排查时 `logcat -d` 都只能看到 hwcomposer，别的全被冲掉了
#   （本次巡检一开始就是这样，抓不到 media.extractor 的死亡现场）。
#
#   16M 之后同样刷屏也能留几个小时的历史。
#   /cache/persist_log.txt 那条落盘链路不受影响（它自己带 4x4MB 轮转）。
#
#   注意：这个线程是闭源 HWC 里的，日志没法关，只能靠放大缓冲区对冲。
#   彻底解决要等 HWC shim 做完（见 patches/README.md 的 HWC 章节），
#   或者把 HWC 完全绕开（当前用 disableHWC=1 走 GLES 合成，
#   但 SF 仍然会加载 hwc 模块，所以线程照跑）。
ro.logd.size=16M

# ============================================================================
# 【2026-11-06 新增】关掉 ART 的 CheckJNI
# ============================================================================
#   这一条是原厂百度输入法（com.baidu.input_baidutv）能在 7.1 上跑起来的
#   必要条件，不是可选项。删掉它，中文输入法就废了。
#
#   【为什么 eng 版默认是开的】
#   build/core/main.mk:383 对 eng variant 自动注入：
#       ADDITIONAL_BUILD_PROPERTIES += ro.kernel.android.checkjni=1
#   所以 /system/build.prop 里天生就有 ro.kernel.android.checkjni=1。
#   这个属性是 ro. 前缀，运行时改不了，只能靠下面这行覆盖。
#
#   【覆盖原理】art/runtime/AndroidRuntime.cpp:637-653
#       bool checkJni = false;
#       property_get("dalvik.vm.checkjni", propBuf, "");
#       if (strcmp(propBuf, "true") == 0) {
#           checkJni = true;
#       } else if (strcmp(propBuf, "false") != 0) {
#           // 只有"既不是 true 也不是 false"才回落到内核参数
#           property_get("ro.kernel.android.checkjni", propBuf, "");
#           if (propBuf[0] == '1') checkJni = true;
#       }
#   也就是说 dalvik.vm.checkjni 显式设成 false 时，那个 else if 分支
#   直接跳过，ro.kernel.android.checkjni=1 不再起作用。
#
#   【到底救了什么】
#   百度输入法是加固包。它的 libchiperencoder_v1_2.so 在 JNI_OnLoad 里
#   RegisterNatives 了一张表，表里有个 nativeChiperGetVersion()I，
#   但 APK 的 classes.dex 里 Lcom/baidu/util/ChiperEncrypt; 根本没这个方法
#   （只有名字相近的 nativeB64GetVersion；在 dex 里搜
#    "nativeChiperGetVersion" 出现 0 次）。
#   Dalvik 对这种情况是静默跳过的，所以 4.4.4 上一直正常；
#   ART 不会 —— art/runtime/jni_internal.cc:2313-2321 无条件抛
#   NoSuchMethodError 并 return JNI_ERR，留下 pending exception。
#
#   接着 art/runtime/java_vm_ext.cc:867-880，JNI_OnLoad 返回后 ART
#   只检查返回值、不检查 pending exception，库算"加载成功"；
#   但库自己在 JNI_OnLoad 里还会调 NewGlobalRef，CheckJNI 见到
#   "带 pending exception 调 JNI" 直接 JniAbort -> LOG(FATAL)：
#       F art: JNI DETECTED ERROR IN APPLICATION:
#              JNI NewGlobalRef called with pending exception
#              java.lang.NoSuchMethodError: ... nativeChiperGetVersion()I
#   进程 SIGABRT，AM 每秒重启 ImeService，键盘永远弹不出来。
#
#   关掉 CheckJNI 后，那个 pending exception 只是留在原地，
#   加固壳入口 com.baidu.input.pub.h.s(Context) -> h.kn() 有 try/catch，
#   异常被吞掉，ImeService.onCreate 继续往下走（实测日志里紧接着就是
#   com.baidu.input.ime.ag.init / p.<init>），键盘正常弹出、
#   拼音候选正常、候选能上屏。实测 "has died" 计数为 0。
#
#   【副作用与取舍】
#   1. 好处：这台机器跑的是 2014 年的 4.4 生态，很多老应用的 JNI 都不干净
#      （老 Dalvik 太宽容），关掉 CheckJNI 对整机兼容性普遍有利。
#   2. 代价：native 层的 JNI 误用不再立刻 abort，排查 native 崩溃时
#      少了一个"直接指认凶手"的信号。需要时临时开回来：
#          adb shell setprop dalvik.vm.checkjni true && adb reboot
#      （必须在 zygote 起来之前设，因为 VM 只读一次）
#   3. 不影响 dex 校验、不影响 SELinux、不影响 APK 签名。
#
#   注意：这一行必须放在 system.prop 里（会被并进 /system/build.prop），
#   不能写进 BoardConfig 的 ADDITIONAL_DEFAULT_PROPERTIES，
#   因为 ro.kernel.android.checkjni 就在 /system/build.prop 里，
#   同文件内靠后出现的 dalvik.vm.checkjni 才能确保生效顺序清晰。
dalvik.vm.checkjni=false


# ============================================================================
# 【2026-11-10 新增】厂商 HWC 合成总开关
#
#   ro.ardbeg.sf_hwc_off=1  启动后把 SurfaceFlinger 的 mDebugDisableHWC 置 1，
#                           禁止 g100 原厂 4.4.4 的 hwcomposer.tegra.so 参与
#                           客户端 layer 合成（只处理 FB TARGET）。默认值。
#   ro.ardbeg.sf_hwc_off=0  不干预，交给厂商 HWC 自己判断是否用 overlay。
#
#   为什么默认是 1（2026-11-10 第二轮实测后的定论）：
#     置 0 会真的让厂商 HWC 去合成（Compositor 变成 glcomposer），
#     然后在它内部的 GL 合成器里 SIGSEGV：
#         #00 RefBase::decStrong+37            (libutils.so)
#         #01 sp<GraphicBuffer>::operator=+22  (hwcomposer.tegra.so)
#         #02 destroy_graphic_buffer+8
#         #04 glc_set+1096
#         #05 hwc_composite_set+252
#     崩完 SF 重启、所有 BufferQueue 变孤儿 -> 永久黑屏。
#     所以 1 不是"保守选择"，而是**唯一能正常显示的配置**。
#     留这个开关是为了将来若修好 hwcomposer.tegra.so 的 glcomposer 崩溃，
#     能一行属性切回去验证，不用重新编译。
#
#   为什么用 ro.* 而不是 persist.*：
#     persist.* 要等 init 执行 on post-fs-data 里的 load_persist_props 才读进
#     属性空间，而 sf_hwc_off.sh 由 zz-sf-hwc-off.rc 的 on post-fs 拉起，
#     那一刻 persist 还是空的，开关会永远失效。ro.* 来自 /system/build.prop，
#     on init 阶段就已就绪。
#
#   注意：早期文档说「4.4.4 与 7.1 的 hwc_layer_1_t 错位 4 字节、SF 每
#   40~100 秒崩一次」——2026-11-10 复核已推翻，两版结构体在 0~72 偏移上
#   逐字段一致，tombstones 里也没有任何 surfaceflinger 记录。论证见
#   initfiles/sf_hwc_off.sh 头部注释。
# ============================================================================
ro.ardbeg.sf_hwc_off=1

# ============================================================================
# 【帧率匹配开关 2026-11-10 新增，2026-11-11 按真实 App 实测重写】
#
#   1 = ardbeg_fps_match.sh 常驻，并自动按片源区间分类切显示刷新率
#   0 = 不自动切：watch 进程仍常驻但停在待机分支，零显示副作用
#       （脚本仍可手动跑 apply/match/detect/auto/status）
#   【2026-11-11】两者都只需 setprop 即生效，不需要 stop/start 服务：
#   常驻服务自己每 5 秒轮询一次开关，详见
#   initfiles/ardbeg_fps_match.sh 的 IDLE_INTERVAL 补记 #2。
#
#   ★ 2026-11-11 策略修正（针对在线视频 App，不是本地测试片）：
#     真实 App（CIBN/优酷）实测同一段观看里帧率会变：
#       片前广告约 25fps（60Hz 下 14.1% 跳帧），正片约 30.13fps
#       （numFramesTotal 15 秒 +452 帧）。
#     30fps 在 60Hz 上本来就是 2:2 完美匹配，切到 50Hz 反而是 5:3
#     pulldown、比不切更差 —— 所以自动模式不能见帧率就套映射表。
#
#     现在脚本：
#       - 帧率检测改用 dumpsys media.player 的 numFramesTotal 累计增量
#         （解码器侧，与 SurfaceFlinger 层、与刷新率都无关），不再用
#         --latency（在线 App 有多个同名层、层会增删、切到 50Hz 后
#         刷新周期行变 20ms 会被误判成 50fps 自我强化）。
#       - 自动模式不做精确吸附（实测 25fps 片源有约 -5% 系统性偏低，
#         24 与 25 只差 4%，边界上会摇摆），改成区间分类：
#         实测 22.00~27.50fps -> 50Hz；其余（含 30/50/60fps）保持 60Hz。
#       - 加滞回(连续 3 轮) / 最短驻留 20s / 最短播放 10s，
#         避免广告<->正片切换时反复切 HDMI 把电视闪黑。
#     详见 initfiles/ardbeg_fps_match.sh 文件头【2026-11-10 补记】。
#
#   为什么默认 0（效果已验证，但仍有代价）：
#     2026-11-10 本地 25.000fps / 425 帧测试片，用渲染端请求的上屏时刻
#     （dumpsys SurfaceFlinger --latency 的 desiredPresentTime）间隔分布衡量：
#         60Hz: 理想 40.0ms 占 84.7%，跳过一帧(83.3ms) 占 12.4%，std 22.46ms
#         50Hz: 理想 40.0ms 占 94.5%，跳过一帧(83.3ms) 占  4.4%，std 11.93ms
#     即切到 50Hz 后被跳过的帧少了约 3 倍，节奏明显更匀。
#     2026-11-11 真机复验：本地片 auto 从 60Hz 切到 50Hz 成功；
#     50Hz 下再 detect 仍判 50Hz（不自我强化）；真实 App 广告期
#     22.66~26.61fps 也都正确判 50Hz；注入 30fps 窗口保持 60Hz。
#
#     注意 numFramesDropped 测不出这个改善（60Hz 6.87% vs 50Hz 6.65%）：
#     pulldown 下每帧都上屏了，只是被保持 2 或 3 个 vsync，
#     那个计数器只统计「来不及被丢掉」的帧，对节奏不匀不敏感。
#
#     仍然默认 0 的两条原因：
#       1) 每次切 HDMI 时序电视都要黑一下重新同步（有的还会弹
#          "1920x1080 50Hz" 角标）。看短视频时这个闪烁比 pulldown 本身更烦，
#          所以脚本里另加了 MIN_PLAY_SEC=10 / MIN_DWELL_SEC=20 兜底，
#          但是否启用仍交给使用者自己权衡。
#       2) 24Hz 自动切换已明确放弃：本机 1080p 模式表里没有 48Hz，
#          24Hz 会把整个系统 UI 拖到 24fps，且部分电视不认 24Hz 输入
#          会回落或黑屏。想要 24p 观感用 `match 24` 手动切。
#
#   要试的话（2026-11-11 更正：watch 服务常驻、每 5 秒轮询一次开关，
#   setprop 即生效，不需要也不应该 stop/start。stop/start 反而会破坏
#   0bfadc0 修好的「常驻待机」状态机，让服务回到「非 oneshot 退出即
#   重启」的老路）：
#     setprop persist.ardbeg.fps_match 1
#     ardbeg_fps_match.sh status
#
#   为什么用 persist.* 而不是 ro.*：
#     ro.* 只能开机时由 init 读一次，运行期 setprop 无效，调试很不方便。
#     persist.* 可以运行期改并写回 /data/property，重启还在。
#     本服务由 on property:sys.boot_completed=1 拉起，那时
#     load_persist_props 早就跑完了，能读到正确值。
# ============================================================================
persist.ardbeg.fps_match=0

# ============================================================================
# 【视频播放 GPU 调频开关 2026-11-11 新增】
#
#   1 = 开机应用修改值（默认）：把 GPU devfreq 三项 debugfs 参数从原厂
#       默认改成让「关掉 HWC 后 SF GLES 合成」跑得动的值，见下。
#   0 = 写回原厂三项默认值（等效于没装这个功能）。
#
#   【背景】ro.ardbeg.sf_hwc_off=1（厂商 hwcomposer 的 glcomposer 在
#   7.1 上会 SIGSEGV，必须关 HWC），于是 1920x1080 全屏画面全部由
#   SurfaceFlinger 用 GLES 合成，GPU 是每帧出图的必经路径。但
#   nvhost_podgov 默认 load_target=700，actmon 把「等 vsync」算成空闲，
#   实测播放 25fps 片源时 load 平均仅 372/1000，governor 判定不忙，
#   GPU 长期停在 72~180MHz（852MHz 一次没上过）；同时
#   gr_idle_timeout=10ms 小于 60Hz 帧间隔 16.67ms，每帧之间必进一次
#   ELPG 电源门控 -> 唤醒重新升频 -> 单帧合成忽长忽短 -> 常错过
#   vsync -> desiredPresentTime 出现 83.3ms 跳帧。
#
#   三项写入值（都在 debugfs，重启即丢，故由 zz-ardbeg-gpu-video.rc
#   在 sys.boot_completed=1 之后开机重写一遍）：
#     scaling/load_target            700   -> 300
#     scaling/use_throughput_hint      0   -> 1
#     gr_idle_timeout_default_us   10000   -> 50000
#
#   【A/B 实测，同一 25.000fps 本地片 / 同一 60Hz / 同一指标】
#     原厂默认        跳帧 14.6%  理想帧 81.6%  上屏延迟 46.5ms
#                     GPU 均频 75.6MHz   解码 24.21fps
#     应用后          跳帧  6.8%  理想帧 93.2%  上屏延迟 32.4ms
#                     GPU 均频 102.6MHz  解码 25.10fps
#     跳帧 -7.7pp / 理想帧 +11.6pp / GPU 均频 +27.0MHz；
#     两轮解码速率与丢帧增量完全相同 -> 改善来自合成/上屏链路，
#     不是解码能力（media_codecs.xml 里 H.264 只有 ffmpeg/google 软解，
#     但 720p/25fps 完全够用）。
#
#   【和帧率匹配的关系】上面 persist.ardbeg.fps_match 修的是「片源帧率
#   与刷新率不整除」(25fps/60Hz 的 3:2 pulldown)；本项修的是「合成链路
#   因 GPU 低频超时错过 vsync」。两层叠加才构成完整卡顿，两项都解决
#   才接近无跳帧。在线 App 片源帧率会动态变化（片前广告约 25fps、
#   正片约 30fps），所以帧率匹配默认 0，而本项对 60/50Hz 都有效、默认 1。
#
#   【风险】降 load_target 让 GPU 更易升频，待机功耗/发热略增；本机有
#   thermal 节流，长时间高负载可能触发。故做成可关，也可运行时手动：
#     ardbeg_gpu_video.sh apply | restore | status
#   setprop 之后需重启，才会在开机入口重新读取该值。
#
#   详见 initfiles/ardbeg_gpu_video.sh 头部（哪些节点可写/写不动、
#   参数含义、完整 A/B 数据）与 initfiles/Android.mk 5.4c 节。
# ============================================================================
persist.ardbeg.gpu_video=1

# ============================================================================
# [ardbeg] 2026-11-13 修复 hwcomposer INFO 刷屏（四清 /data 后的回归）
# 现象：厂商 hwcomposer 的 propmonitor_thread 会反复打印
#       "process event IN_CLOSE_NOWRITE overscan_rate:0 ..."，
#       在 logcat main 缓冲里可占 28%~99%（11-12 曾实测 99.5%），
#       把真正有用的调试日志冲掉。
# 根因：该日志是 INFO 级别。11-12 曾手工 setprop
#       persist.log.tag.hwcomposer W + stop logd; start logd 修掉，
#       但 persist.* 属性存于 /data/property，11-13 用户在 TWRP
#       做四清（wipe /data）后该属性丢失 -> 刷屏回归（01:15 实测 28.5%）。
# 修法：把该属性作为默认值写进 system.prop（编译进 /system/build.prop）。
#       init 加载 build.prop 时若 /data/property 无持久值即采用此默认值，
#       以后再四清也会自动生效；用户手工 setprop 的值仍可覆盖。
# 生效条件：log.tag.* 过滤规则在 logd 启动时读取，本项是开机默认值，
#       开机即生效，无需额外 stop/start logd。
# 验证（01:15 真机）：setprop W + stop logd; start logd 后，
#       logcat -b main -t 400 的 hwcomposer 行 116/407 (28.5%) -> 0/98 (0.0%)，
#       写入后读回 = W，PASS。
# 回退：删除本行，并 setprop persist.log.tag.hwcomposer '' 后重启 logd。
# 边界：只改日志过滤级别，不改变 hwcomposer 行为；sf_hwc_off=1
#       （禁用厂商 HWC 合成）仍是防黑屏主保险，勿置 0。
# ============================================================================
persist.log.tag.hwcomposer=W
