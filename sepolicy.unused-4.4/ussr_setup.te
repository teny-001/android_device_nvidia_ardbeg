#
# ussr_setup.sh - power management service setup
#
# 【7.1 移植改动 2026-11-04】两个 type 声明注释掉：
#   shield-common/sepolicy/common/ussr_setup.te 第 18、19 行已经声明了
#   ussr_setup / ussr_setup_exec，重复声明会让 checkpolicy 报
#   'duplicate declaration of type/attribute' 并中断编译。
#type ussr_setup, domain;
#type ussr_setup_exec, exec_type;

init_daemon_domain(ussr_setup)

allow ussr_setup self:capability { dac_override chown fowner fsetid };

allow ussr_setup default_prop:property_service set;

# file access permisions
allow ussr_setup system_file:file x_file_perms;
allow ussr_setup shell_exec:file rx_file_perms;
allow ussr_setup property_socket:sock_file write;
# chmod/chown sysfs /sys/...
allow ussr_setup sysfs:file { setattr rw_file_perms };
allow ussr_setup sysfs:dir r_dir_perms;
allow ussr_setup debugfs:file { setattr rw_file_perms };
# chmod/chown /dev/...
# Note: might make this more specific if policy set for constraint devices
allow ussr_setup debugfs:dir r_dir_perms;
# /data/misc/phs
allow ussr_setup system_data_file:dir  { create_dir_perms relabelfrom };
allow ussr_setup system_data_file:file create_file_perms;
# ussrd files
allow ussr_setup ussr_setup_exec:file rx_file_perms;
allow ussr_setup phsd_socket:dir create_dir_perms;
allow ussr_setup phsd_socket:chr_file create_file_perms;
