on post-fs-data
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/firmware 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    #create gps files
    mkdir /data/gps
    chown gps system /data/gps/
    chmod 0770 /data/gps/

    service start-gps /system/bin/gps_select.sh
        user root
        group root
        class late_start
        oneshot

    # ---------------------------------------------------------------------
    # [ardbeg] 2026-11-12 补齐 SELinux 域声明，消除 init 域告警
    # 现象：dmesg 里 `init: Service start-gps does not have a SELinux domain defined.`
    # 根因：本机 rootfs 是 ramfs，不支持 TMPFS_XATTR（见
    #       `restorecon("/init") failed: Operation not supported ...`），
    #       init 自身停在 u:r:kernel:s0；Service::Start() 的 ComputeContext()
    #       以 kernel 域为源去查 type_transition（策略里的规则都以
    #       u:r:init:s0 为源），算出的 scon 与 mycon 相同 -> 打印该 ERROR，
    #       服务实际也留在 u:r:kernel:s0（已实测 /proc/<pid>/attr/current）。
    # 修法：显式 seclabel u:r:init:s0，让 init 走 service.cpp 的
    #       `if (!seclabel_.empty())` 短路分支，不再调用 ComputeContext()。
    # 安全性：u:r:init:s0 在 /sepolicy 类型表中真实存在（已解析校验）；
    #       当前 androidboot.selinux=permissive，域变化只记录 avc、不阻断功能；
    #       11-12 已用同一模式为 sf_hwc_off 补齐并重启验证 PASS。
    # 边界：本行只消除域告警；若日后切回 enforcing，应改为各服务自身真实域。
    # 回退：删除本行；批量回退脚本 wb_tmp/restore_seclabel_all.sh。
    # ---------------------------------------------------------------------
    seclabel u:r:init:s0
on boot

    # bluetooth
    # change back to bluetooth from system
    chown bluetooth net_bt_stack /data/misc/bluetooth

    # UART device
    chmod 0660 /dev/ttyHS2
    chown bluetooth net_bt_stack /dev/ttyHS2
    chmod 0660 /dev/ttyTHS2
    chown bluetooth net_bt_stack /dev/ttyTHS2

    # power up/down interface
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    write /sys/class/rfkill/rfkill0/state 0
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/type

    # bluetooth MAC address programming
    #
    # 【不要 setprop ro.bt.bdaddr_path】
    #   ro.* 是"写一次"属性。system.prop 里已经有
    #       ro.bt.bdaddr_path=/mnt/factory/bluetooth/bt_mac.txt
    #   它在 on post-fs 的 load_system_props 阶段就写进 build.prop 了，早于本段，
    #   所以这里再设一次必然失败，每次开机固定报一行：
    #       init: property_set("ro.bt.bdaddr_path", "...") failed
    #   实测 getprop ro.bt.bdaddr_path 取到的正是 build.prop 的值，功能无缺失。
    #
    # 【另注：蓝牙 MAC 本身也拿不到工厂值】
    #   本机 /mnt/factory（FCT 分区）挂载正常但**是空的**，只有 lost+found，
    #   所以 bt_mac.txt 本来就不存在。这是工厂分区数据缺失，不是软件问题，
    #   改策略/改 rc 都补不回来。
    #
    #   chown ... ro.bt.bdaddr_path 这一行同理是 4.4 时代遗留：它作用的
    #   /ro.bt.bdaddr_path 从来不存在，是个 no-op，保留不动。
    chown bluetooth net_bt_stack ro.bt.bdaddr_path
    chown bluetooth net_bt_stack /system/etc/bluetooth
    chown bluetooth net_bt_stack /mnt/factory/bluetooth/bt_mac.txt
    # setprop ro.bt.bdaddr_path "/mnt/factory/bluetooth/bt_mac.txt"

#ozwpan driver: WiFi direct USB shim driver
    chown system system /dev/ozwpan
    chown system system /sys/class/ozmo_wpan/ozwpan/devices
    chown system system /sys/class/ozmo_wpan/ozwpan/select
    chown system system /sys/class/ozmo_wpan/ozwpan/bind
    chmod 0660 /sys/class/ozmo_wpan/ozwpan/bind

# Wifi support rx-filter
    setprop wifi.rx-filter 1

    setprop persist.sys.commchip_vendor 0x02d0
    setprop persist.sys.commchip_device 0x4354

service dhcpcd_p2p_wlan0 /system/bin/dhcpcd p2p-wlan0-0
    class main
    disabled
    oneshot

service dhcpcd_p2p_p2p0 /system/bin/dhcpcd p2p-p2p0-0
    class main
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_eth0 /system/bin/dhcpcd -ABKL -f/system/etc/dhcpcd/dhcpcd.conf
     class main
     disabled
     oneshot

service dhcpcd_bt-pan /system/bin/dhcpcd -ABKL
    class main
    disabled
    oneshot

service iprenew_bt-pan /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_eth0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

# wifiloader - set the wifi commchip_id accordingly
#
# [CM14.1-on-ardbeg 修改 2026-11-06] 加 oneshot
#
# 原厂 4.4.4 的这份 rc 没写 oneshot，而 wifi_loader.sh 是个**一次性脚本**
# （读完 commchip id、load 完 bcmdhd 就 exit 0）。没有 oneshot 的话，
# init 会把「非 oneshot 服务退出」当成崩溃，立刻重新拉起：
#
#     dmesg: init: Service 'wifiloader' (pid 1322) exited with status 0
#            init: Service 'wifiloader' (pid 1322) killing any children in process group
#            init: Starting service 'wifiloader'...
#
# 实测每 5 秒一轮（561s / 566s / 571s / 576s / 581s ...），开机 10 分钟
# 已经重启 115 次，同时刷 254 条
#     init: Service wifiloader does not have a SELinux domain defined.
# 把 dmesg 冲得全是噪音，真正的问题反而看不见。
#
# 加 oneshot 之后跑一次就完事，和 iprenew_eth0 / dns_masq 的写法一致。
service wifiloader /system/bin/wifi_loader.sh
    class main
    user root
    group root
    oneshot

    # ---------------------------------------------------------------------
    # [ardbeg] 2026-11-12 补齐 SELinux 域声明，消除 init 域告警
    # 现象：dmesg 里 `init: Service wifiloader does not have a SELinux domain defined.`
    # 根因：本机 rootfs 是 ramfs，不支持 TMPFS_XATTR（见
    #       `restorecon("/init") failed: Operation not supported ...`），
    #       init 自身停在 u:r:kernel:s0；Service::Start() 的 ComputeContext()
    #       以 kernel 域为源去查 type_transition（策略里的规则都以
    #       u:r:init:s0 为源），算出的 scon 与 mycon 相同 -> 打印该 ERROR，
    #       服务实际也留在 u:r:kernel:s0（已实测 /proc/<pid>/attr/current）。
    # 修法：显式 seclabel u:r:init:s0，让 init 走 service.cpp 的
    #       `if (!seclabel_.empty())` 短路分支，不再调用 ComputeContext()。
    # 安全性：u:r:init:s0 在 /sepolicy 类型表中真实存在（已解析校验）；
    #       当前 androidboot.selinux=permissive，域变化只记录 avc、不阻断功能；
    #       11-12 已用同一模式为 sf_hwc_off 补齐并重启验证 PASS。
    # 边界：本行只消除域告警；若日后切回 enforcing，应改为各服务自身真实域。
    # 回退：删除本行；批量回退脚本 wb_tmp/restore_seclabel_all.sh。
    # ---------------------------------------------------------------------
    seclabel u:r:init:s0
service dns_masq /system/bin/dnsmasq --no-daemon --no-resolv --no-poll --dhcp-option-force=43,ANDROID_METERED --dhcp-range=192.168.42.2,192.168.42.254,1h &
    class main
    user dhcp
    group dhcp wifi system
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant.sh
#   we will start as root and wpa_supplicant will switch to user wifi
#   after setting up the capabilities required for WEXT
#   user wifi
#   group wifi inet keystore
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant.sh
#   we will start as root and wpa_supplicant will switch to user wifi
#   after setting up the capabilities required for WEXT
#   user wifi
#   group wifi inet keystore
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# Enable rbe
# thresIncr:50  thresIncrCntMax:6  thresDecr:70  thresDecrCntMax:2
# The change from default is the thresDecrCntMax.  Default is 3.
#
# 【修复 2026-11-04】注释掉 wlbwservice 服务定义。
#
# 原来的定义：
#     service wlbwservice /system/bin/wlbwservice -t 50 6 70 2
#         class main
#         user system
#         group system inet net_admin
#
# 问题：/system/bin/wlbwservice 在这套 ROM 里不存在（真机确认）：
#     # ls -l /system/bin/wlbwservice
#     /system/bin/wlbwservice: No such file or directory
#   vendor blobs 只带了 libwlbwservice.so（见 ardbeg-vendor-blobs.mk:151），
#   没有可执行文件本身。所以 init 每次开机都报：
#     init: cannot find '/system/bin/wlbwservice', disabling 'wlbwservice'
#
#   wlbwservice 是 Broadcom 的 RBE（Rate-Based-Enhancement）省电策略服务，
#   缺失只会让 WiFi 少一层动态速率/功耗调节，不影响联网和开机。
#   它和音频、显示都无关，属于纯粹的噪音定义。
#   以后若要恢复，需要从原厂包补回 /system/bin/wlbwservice 及其依赖。
#
# service wlbwservice /system/bin/wlbwservice -t 50 6 70 2
#     class main
#     user system
#     group system inet net_admin

# Start GPS daemon
    # ---------------------------------------------------------------------
    # [ardbeg] 2026-11-12 补齐 SELinux 域声明，消除 init 域告警
    # 现象：dmesg 里 `init: Service p2p_supplicant does not have a SELinux domain defined.`
    # 根因：本机 rootfs 是 ramfs，不支持 TMPFS_XATTR（见
    #       `restorecon("/init") failed: Operation not supported ...`），
    #       init 自身停在 u:r:kernel:s0；Service::Start() 的 ComputeContext()
    #       以 kernel 域为源去查 type_transition（策略里的规则都以
    #       u:r:init:s0 为源），算出的 scon 与 mycon 相同 -> 打印该 ERROR，
    #       服务实际也留在 u:r:kernel:s0（已实测 /proc/<pid>/attr/current）。
    # 修法：显式 seclabel u:r:init:s0，让 init 走 service.cpp 的
    #       `if (!seclabel_.empty())` 短路分支，不再调用 ComputeContext()。
    # 安全性：u:r:init:s0 在 /sepolicy 类型表中真实存在（已解析校验）；
    #       当前 androidboot.selinux=permissive，域变化只记录 avc、不阻断功能；
    #       11-12 已用同一模式为 sf_hwc_off 补齐并重启验证 PASS。
    # 边界：本行只消除域告警；若日后切回 enforcing，应改为各服务自身真实域。
    # 回退：删除本行；批量回退脚本 wb_tmp/restore_seclabel_all.sh。
    # ---------------------------------------------------------------------
    seclabel u:r:init:s0
service gps-daemon /system/bin/glgps_nvidiaTegra2android -c /system/etc/gps/gpsconfig.xml
    user gps
    socket gps seqpacket 0660 gps system
    group system inet sdcard_rw sdcard_r
    class main
    disabled
