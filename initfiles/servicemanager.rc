# ============================================================================
# servicemanager 服务定义 —— CM14.1-on-ardbeg 定制版
#
# 与 AOSP 7.1 原版（frameworks/native/cmds/servicemanager/servicemanager.rc）
# 的唯一差别是末尾多了一行：
#
#     setenv LD_PRELOAD /system/lib/libselinux_bypass.so
#
# 【为什么需要这一行】
#
# 7.1 把「谁能注册 binder 服务」的权限检查从 binder class 拆到了新的
# service_manager class（frameworks/native/cmds/servicemanager/service_manager.c:83）：
#
#     static int check_mac_perms(...) {
#         ...
#         int result = selinux_check_access(sctx, tctx, "service_manager", perm, &ad);
#     }
#
# 本机用的是原厂 4.4.4 的 /sepolicy，dmesg 实测只有 84 个 class：
#
#     SELinux:  1 users, 2 roles, 307 types, 1 bools, 1 sens, 1024 cats
#     SELinux:  84 classes, 3023 rules
#
# 里面根本没有 service_manager 这个 class。于是 security_compute_av() 在查
# class 表时直接失败返回 -1，servicemanager 判定「无权限」，开机日志里是：
#
#     E/SELinux (213): Unknown class service_manager
#     E/ServiceManager(213): add_service('batterystats',...) uid=1000
#                           - PERMISSION DENIED
#     E/ServiceManager(213): add_service('netd',1) uid=0 - PERMISSION DENIED
#
# 【为什么 permissive 救不了】
#
# androidboot.selinux=permissive 只影响「已经判定为 deny 的操作要不要真拦」。
# 这里的失败发生在**判定过程本身**（class 查不到），压根走不到 permissive
# 分支，所以照样拒。
#
# 【后果】
#
# system_server 启动 AMS 时 BatteryStatsService.publish() 调
# ServiceManager.addService() 抛 SecurityException：
#
#     java.lang.RuntimeException: Failed to start service
#         com.android.server.am.ActivityManagerService$Lifecycle:
#         onStart threw an exception
#     Caused by: java.lang.SecurityException
#         at android.os.ServiceManagerProxy.addService(...)
#         at com.android.server.am.BatteryStatsService.publish(...)
#
# 接着 "FATAL EXCEPTION IN SYSTEM PROCESS"，zygote 退出，init 重拉，
# 无限循环 —— 现象就是「设备不启动」。
#
# 【垫片做了什么】
#
# libselinux_bypass.so 覆盖了 selinux_check_access()，无条件返回 0（=允许）。
# SELinux 本身已经是 permissive 且策略残缺，服务注册这一层放行没有实际安全
# 损失；等换自编内核 + 7.1 完整 sepolicy 后，删掉这行和那个 .so 即可。
# 完整推导见 device/nvidia/ardbeg/prebuilt/lib/libselinux_bypass.c 头部注释。
# ============================================================================
service servicemanager /system/bin/servicemanager
    class core
    user system
    group system readproc
    critical
    onrestart restart healthd
    onrestart restart zygote
    onrestart restart audioserver
    onrestart restart media
    onrestart restart surfaceflinger
    onrestart restart inputflinger
    onrestart restart drm
    onrestart restart cameraserver
    writepid /dev/cpuset/system-background/tasks
    setenv LD_PRELOAD /system/lib/libselinux_bypass.so
