--- a/build/core/java.mk
+++ b/build/core/java.mk
@@ -518,7 +518,34 @@
 endif
 
 # jack already has the libraries in its classpath and doesn't support jars
-legacy_proguard_flags := $(addprefix -libraryjars ,$(my_support_library_sdk_raise) $(full_shared_java_libs))
+# ---------------------------------------------------------------------------
+# [ardbeg] 去重 -libraryjars，修 "same input jar specified twice"
+#
+# 原始写法是
+#   $(addprefix -libraryjars ,$(my_support_library_sdk_raise) $(full_shared_java_libs))
+# 两个来源可能给出同一个 jar：
+#   * full_shared_java_libs —— 来自 LOCAL_JAVA_LIBRARIES + TARGET_DEFAULT_JAVA_LIBRARIES
+#   * my_support_library_sdk_raise —— 上面那个 "Hack: see b/20667396" 分支，
+#     为了压掉 support 库的 SDK 版本告警，会把 TARGET_DEFAULT_JAVA_LIBRARIES
+#     整体再塞一遍（里面就含 framework.jar）
+# 只要模块同时写了 LOCAL_JAVA_LIBRARIES := framework 和 LOCAL_SDK_VERSION := current，
+# 并且静态链接了 android-support-*，framework_intermediates/classes.jar 就会出现两次，
+# ProGuard 5.1 直接报错退出：
+#   Error: The same input jar [.../framework_intermediates/classes.jar] is specified twice.
+# 实测第一个撞上的是 EmergencyInfo（packages/apps/EmergencyInfo/Android.mk
+# 同时有 LOCAL_JAVA_LIBRARIES := framework 和 LOCAL_SDK_VERSION := current）。
+#
+# 用 $(filter-out) 去掉重复项，而**不能用 $(sort)**：
+#   ProGuard 解析同名类时以**第一个**出现的 library jar 为准。原来 my_support_library_sdk_raise
+#   （里面是完整 framework.jar）排在前面，所以 @hide 方法能被解析；一旦用 $(sort)
+#   按字典序排，android_stubs_current 会排到 framework_intermediates 前面，
+#   stubs 里没有 @hide 成员，于是又冒出一堆
+#     Warning: com.android.settingslib.BatteryInfo: can't find referenced method
+#         'java.lang.String formatShortElapsedTime(android.content.Context,long)'
+#         in library class android.text.format.Formatter
+#   （实测 EmergencyInfo 就是这样炸的）。所以这里保持原顺序、只做去重。
+# ---------------------------------------------------------------------------
+legacy_proguard_flags := $(addprefix -libraryjars ,$(my_support_library_sdk_raise) $(filter-out $(my_support_library_sdk_raise),$(full_shared_java_libs)))
 
 legacy_proguard_flags += -printmapping $(proguard_dictionary)
 jack_proguard_flags := -printmapping $(jack_dictionary)
@@ -618,6 +645,49 @@
 endif
 endif # LOCAL_JACK_ENABLED is disabled
 
+# ===========================================================================
+# [ardbeg] 补回非 Jack 路径的 dex 产出规则
+#
+# 问题：本树的 build/core/java.mk 在 `ifndef LOCAL_JACK_ENABLED` 分支里只给
+#       $(built_dex_intermediate) 设了 PRIVATE_DX_FLAGS，却没有写 recipe。
+#       一旦把 Jack 关掉（ANDROID_COMPILE_WITH_JACK=false），ninja 立刻报：
+#         .../APPS/xxx_intermediates/with-local/classes.dex
+#             missing and no known rule to make it
+#       而 $(built_dex) 依赖 $(built_dex_intermediate)，于是整条 Java 编译链断掉，
+#       连 BasicDreams 这种最小模块都编不过。
+#
+# 处理：按 AOSP 上游非 Jack 分支的写法补一条 dx 规则：
+#       把 proguard 处理后的 jar（$(full_classes_proguard_jar)）转成 dex。
+#       $(PRIVATE_DX_FLAGS) 由上面第 605~618 行填充（含 emma 时的 --no-locals）。
+#
+# 说明：
+#   * $(DX) = $(HOST_OUT_EXECUTABLES)/dx，由 dalvik/dx 构建，是纯 Java 工具，
+#     不依赖 Jack 那套 TLS 服务，正好绕开本机 curl/OpenSSL3 与 Jack 1.3 的握手问题。
+#   * 只在 `ifdef full_classes_jar` 的作用域内（本行上方第 349 行开始）才需要，
+#     没有 Java 源码的 APK（如 framework-res）不会走到这里。
+#   * 输出固定写成单文件 $@（with-local/classes.dex），dx 若超限会自己报错，
+#     不会静默产出 classes2.dex 让后面的 cp 规则抓错文件。
+#   * **必须用 ifndef LOCAL_JACK_ENABLED 包起来**。make 对同一目标的多条规则
+#     会合并前置依赖，Jack 分支第 784 行自己也定义了
+#         $(built_dex_intermediate): $(jack_all_deps) | setup-jack-server
+#     如果不加守卫，Jack 模块就会额外依赖 full_classes_proguard_jar
+#     → full_classes_jar → javac 的 transform-java-to-classes.jar，
+#     也就是 Jack 模块也白跑一遍 javac。而 javac 的 classpath 全是 .jar，
+#     Jack 构建只产出 .jack，于是报
+#         错误: 程序包org.junit不存在 / 程序包com.android.okhttp不存在
+#     日志里同时会出现
+#         java.mk:785: warning: overriding commands for target .../with-local/classes.dex
+#     正是两条规则撞在同一目标上的证据。
+#   * 下面的 $(built_dex) 拷贝规则**不**加守卫：Jack 分支只产出
+#     built_dex_intermediate，拷到 built_dex 这一步两边都要用。
+# ===========================================================================
+ifndef LOCAL_JACK_ENABLED
+$(built_dex_intermediate): $(full_classes_proguard_jar) $(DX)
+	@echo "target Dex: $(LOCAL_MODULE)"
+	@mkdir -p $(dir $@)
+	$(hide) $(DX) $(PRIVATE_DX_FLAGS) --dex --output=$@ $<
+endif # LOCAL_JACK_ENABLED
+
 $(built_dex): $(built_dex_intermediate) | $(ACP)
 	@echo Copying: $@
 	$(hide) mkdir -p $(dir $@)
