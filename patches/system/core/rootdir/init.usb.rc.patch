 # USB configuration common for all android devices
@@ -12,7 +92,7 @@
     mkdir /data/adb 0700 root root
 
 # adbd is controlled via property triggers in init.<platform>.usb.rc
-service adbd /sbin/adbd --root_seclabel=u:r:su:s0
+service adbd /sbin/adbd
     class core
     socket adbd stream 660 system system
     disabled
@@ -42,6 +122,109 @@
     write /sys/class/android_usb/android0/functions ${sys.usb.config}
     write /sys/class/android_usb/android0/enable 1
     start adbd
+    setprop sys.usb.state ${sys.usb.config}
+
+# =============================================================================
+# [CM14.1-on-ardbeg 新增 2026-11-06] MTP / PTP 的 legacy(android_usb) 规则
+# -----------------------------------------------------------------------------
+# 【为什么必须自己写这两段】
+# AOSP 7.1 把 MTP/PTP 的配置整体搬到了 configfs 方案里
+# （见 system/core/rootdir/init.usb.configfs.rc 第 25/38/55/68 行），
+# 系统自带的 init.usb.rc 只保留 adb / accessory / audio_source 这几个最基础的
+# fallback，**一条 mtp/ptp 的 property 触发都没有**。
+#
+# 而本机内核是原厂 4.4.4 的 NVIDIA gadget，没有 configfs 支持
+# （/config/usb_gadget 不存在，sys.usb.configfs=0），只能走
+# /sys/class/android_usb/android0 这套老接口。两边一凑，结果就是：
+#
+#     framework 把 sys.usb.config 设成 "mtp,adb"
+#       -> init 里没有任何 action 匹配
+#       -> /sys/class/android_usb/android0/functions 原封不动
+#       -> sys.usb.state 停在旧值
+#       -> UsbDeviceManager.waitForState("mtp,adb") 5 秒超时
+#       -> "Failed to switch USB config to mtp,adb"
+#       -> 一路 failsafe 回落到 adb-only
+#
+# 最终表现就是用户看到的"插上电脑只有 adb，没有盘符"。
+# 内核侧其实是好的：f_mtp 已编译进去，/dev/mtp_usb 存在，
+# 手工 echo mtp,adb > functions 能打出 "mtp_bind_config" 并成功枚举，
+# 缺的纯粹是 init 这一层的触发规则。
+#
+# 【为什么用 18d1:4ee1/4ee2 而不是原厂的 0955:701a/701b】
+# 1) 18d1:4ee2 是 AOSP 标准的「MTP + ADB」组合，Windows 10/11 自带 MTP 驱动，
+#    插上直接认成便携设备、能直接浏览内部存储；0955:xxxx 需要额外装
+#    NVIDIA 的 USB 驱动才能识别。
+# 2) 原厂 init.nv_dev_board.usb.rc 里写的是 ${ro.nv.usb.vid}，其值为字符串
+#    "0x0955"，而内核 DESCRIPTOR_ATTR(idVendor, "%04x\n") 的字段宽度是 4 ——
+#    sscanf 会把 "0x0955" 截成 "0x09"。实测：
+#        echo 0x0955 > idVendor; cat idVendor  ->  0009
+#        echo 0955   > idVendor; cat idVendor  ->  0955
+#    VID 直接错成 0x0009。这是原厂配置里的一个隐藏 bug，我们不复用。
+#
+# 【bDeviceClass 为什么显式写 0】
+# MTP 是 per-interface 设备（bDeviceClass=0，由接口描述符声明
+# Still Image / MTP 类），而 rndis 需要 224(0xE0, Wireless Controller)。
+# 原来 adb-only 时是 0，但如果之前切过 rndis 残留了 224，
+# 主机就会按无线设备去解析，MTP 接口根本不会被读，所以这里显式清零。
+#
+# 【functions 为什么直接写 ${sys.usb.config}】
+# 内核 functions_store() 会按逗号切分，逐个查 function 注册表；
+# "adb" 不在注册表里，但它被 f_ffs/aliases 别名成了 ffs
+# （见上面 on init 段的 write .../f_ffs/aliases adb），
+# 所以 "mtp,adb" 实际会启用 mtp + ffs 两个 function。
+# 读回来时 functions_show 打印的是内核内部名，会显示成 "mtp,ffs"，
+# 这是正常现象，不是配置错了。
+#
+# 【顺序不能变】
+#   enable 0            gadget 从 UDC 断开，functions_store 才允许改写
+#                       （dev->enabled 时写 functions 直接返回 -EBUSY）
+#   idVendor/idProduct  描述符，enable 1 时才拷进 composite 的副本
+#   bDeviceClass        同上
+#   functions           装配 function 链表
+#   enable 1            重新 bind 并让主机重新枚举
+#   start adbd          ffs 的 ep0 需要 adbd 重新打开（已运行则是 no-op）
+# =============================================================================
+on property:sys.usb.config=mtp && property:sys.usb.configfs=0
+    write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idVendor 18d1
+    write /sys/class/android_usb/android0/idProduct 4ee1
+    write /sys/class/android_usb/android0/bDeviceClass 0
+    write /sys/class/android_usb/android0/functions ${sys.usb.config}
+    write /sys/class/android_usb/android0/enable 1
+    setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=0
+    write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idVendor 18d1
+    write /sys/class/android_usb/android0/idProduct 4ee2
+    write /sys/class/android_usb/android0/bDeviceClass 0
+    write /sys/class/android_usb/android0/functions ${sys.usb.config}
+    write /sys/class/android_usb/android0/enable 1
+    start adbd
+    setprop sys.usb.state ${sys.usb.config}
+
+# -----------------------------------------------------------------------------
+# PTP（相机模式）—— 和 MTP 同一份 f_mtp 驱动，只是接口描述符不同，
+# 内核里由 ptp_function 提供（android.c:596，name="ptp"）。
+# PID 用 AOSP 标准值 4ee5/4ee6，Windows 会认成「数码相机」。
+# -----------------------------------------------------------------------------
+on property:sys.usb.config=ptp && property:sys.usb.configfs=0
+    write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idVendor 18d1
+    write /sys/class/android_usb/android0/idProduct 4ee5
+    write /sys/class/android_usb/android0/bDeviceClass 0
+    write /sys/class/android_usb/android0/functions ${sys.usb.config}
+    write /sys/class/android_usb/android0/enable 1
+    setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=0
+    write /sys/class/android_usb/android0/enable 0
+    write /sys/class/android_usb/android0/idVendor 18d1
+    write /sys/class/android_usb/android0/idProduct 4ee6
+    write /sys/class/android_usb/android0/bDeviceClass 0
+    write /sys/class/android_usb/android0/functions ${sys.usb.config}
+    write /sys/class/android_usb/android0/enable 1
+    start adbd
     setprop sys.usb.state ${sys.usb.config}
 
 # USB accessory configuration
