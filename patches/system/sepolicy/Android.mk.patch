--- a/system/sepolicy/Android.mk
+++ b/system/sepolicy/Android.mk
@@ -99,6 +99,11 @@
 		-D target_needs_platform_text_relocations=$(TARGET_NEEDS_PLATFORM_TEXT_RELOCATIONS) \
 		-D shipping_build=$(CYNGN_TARGET) \
 		-s $^ > $@
+	# 【v28 降级】剥离 xperm 语句：见 device/nvidia/ardbeg/patches/README.md
+	#   内核 POLICYDB_VERSION_MAX=28（xperms 之前），checkpolicy -c 28 拒绝写
+	#   allowxperm/neverallowxperm。这些语句只约束 ioctl 白名单，在 permissive
+	#   下没有实际约束力，剥掉不改变可执行策略的行为。
+	$(hide) awk '/^(allow|auditallow|dontaudit|neverallow)xperm[ \t]/{x=1} x==0{print} x==1&&/;[ \t]*$$/{x=0}' $@ > $@.noxperm && mv $@.noxperm $@
 	$(hide) sed '/dontaudit/d' $@ > $@.dontaudit
 
