--- a/frameworks/native/cmds/installd/installd.rc
+++ b/frameworks/native/cmds/installd/installd.rc
@@ -1,3 +1,51 @@
+# ============================================================================
+# [CM14.1-on-ardbeg 修复 2026-11-06] installd 注入 SELinux 旁路垫片
+#
+# installd 给每个应用建完 /data/data/<pkg> 和 /data/user_de/0/<pkg> 后，
+# 要调 selinux_android_restorecon_pkgdir() 打 SELinux 标签。本机
+# /file_contexts.bin 是原厂 4.4.4 的，libselinux 是 7.1 的，两者对
+# file_contexts 二进制格式解析不一致，selabel_open() 拿到的 handle 不可用，
+# restorecon 内部解引用撞空指针。tombstone 现场：
+#     pid: 25711, name: installd
+#     signal 11 (SIGSEGV), code 1 (SEGV_MAPERR), fault addr 0x4
+#     #00 pc 0000c612  /system/lib/libselinux.so
+#     #01 pc 0000b993  /system/lib/libselinux.so
+#     #02 pc 00004e5b  /system/bin/installd
+#
+# 后果链（「设备不启动」的第二层原因）：
+#   installd 每建一个应用目录就 SIGSEGV
+#     -> /data/user_de/0/com.android.providers.settings 建不出来
+#     -> SettingsProvider 打不开 databases/settings.db
+#        E/SQLiteLog: (14) os_unix.c:32493: (2) open(/data/user_de/0/
+#            com.android.providers.settings/databases/settings.db)
+#     -> InputMethodManagerService 构造时读 Settings.Secure 抛异常
+#     -> "FATAL EXCEPTION IN SYSTEM PROCESS"，zygote 退出，无限循环
+# 注意路径是 /data/user_de/0/（7.1 新增的 device-encrypted 存储），
+# 不是 /data/data/ —— 7.1 的 SettingsProvider 把 settings.db 放在前者。
+#
+# 垫片覆盖 selinux_android_restorecon / _pkgdir / _recursive，统一返回 0。
+# 副作用：新装应用的数据目录标签会是 system_data_file 而不是 app_data_file，
+# permissive 下不产生 deny，功能无影响。
+# ============================================================================
 service installd /system/bin/installd
     class main
     socket installd stream 600 system system
+    setenv LD_PRELOAD /system/lib/libselinux_bypass.so
+    # ---------------------------------------------------------------------
+    # [ardbeg] 2026-11-12 补齐 SELinux 域声明，消除 init 域告警
+    # 现象：dmesg 里 `init: Service installd does not have a SELinux domain defined.`
+    # 根因：本机 rootfs 是 ramfs，不支持 TMPFS_XATTR（见
+    #       `restorecon("/init") failed: Operation not supported ...`），
+    #       init 自身停在 u:r:kernel:s0；Service::Start() 的 ComputeContext()
+    #       以 kernel 域为源去查 type_transition（策略里的规则都以
+    #       u:r:init:s0 为源），算出的 scon 与 mycon 相同 -> 打印该 ERROR，
+    #       服务实际也留在 u:r:kernel:s0（已实测 /proc/<pid>/attr/current）。
+    # 修法：显式 seclabel u:r:init:s0，让 init 走 service.cpp 的
+    #       `if (!seclabel_.empty())` 短路分支，不再调用 ComputeContext()。
+    # 安全性：u:r:init:s0 在 /sepolicy 类型表中真实存在（已解析校验）；
+    #       当前 androidboot.selinux=permissive，域变化只记录 avc、不阻断功能；
+    #       11-12 已用同一模式为 sf_hwc_off 补齐并重启验证 PASS。
+    # 边界：本行只消除域告警；若日后切回 enforcing，应改为各服务自身真实域。
+    # 回退：删除本行；批量回退脚本 wb_tmp/restore_seclabel_all.sh。
+    # ---------------------------------------------------------------------
+    seclabel u:r:init:s0
