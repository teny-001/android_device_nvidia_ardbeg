--- a/frameworks/native/cmds/servicemanager/servicemanager.rc
+++ b/frameworks/native/cmds/servicemanager/servicemanager.rc
@@ -1,6 +1,57 @@
+# ============================================================================
+# [CM14.1-on-ardbeg 修复 2026-11-06] servicemanager 注入 SELinux 旁路垫片
+#
+# 7.1 把「谁能注册 binder 服务」的权限检查从 binder class 拆到了新的
+# service_manager class（本目录 service_manager.c:83 的 selinux_check_access）。
+# 本机用的是原厂 4.4.4 的 /sepolicy，只有 84 个 class，没有 service_manager。
+# 于是 security_compute_av() 查 class 表直接失败返回 -1，servicemanager 判定
+# 「无权限」，开机日志里是：
+#     E/SELinux (213): Unknown class service_manager
+#     E/ServiceManager(213): add_service('batterystats',...) uid=1000
+#                           - PERMISSION DENIED
+#
+# permissive 救不了：失败发生在**判定过程本身**（class 查不到），走不到
+# permissive 分支。
+#
+# 后果：system_server 启动 AMS 时 BatteryStatsService.publish() 抛
+# SecurityException -> "Failed to start service
+# ActivityManagerService$Lifecycle: onStart threw an exception" ->
+# "FATAL EXCEPTION IN SYSTEM PROCESS"，zygote 退出，无限循环。
+#
+# 垫片覆盖 selinux_check_access() 无条件返回 0（=允许）。SELinux 本身已是
+# permissive 且策略残缺，服务注册这一层放行没有实际安全损失。
+# ============================================================================
 service servicemanager /system/bin/servicemanager
     class core
     user system
+    group system readproc
+    critical
+    onrestart restart healthd
+    onrestart restart zygote
+    onrestart restart audioserver
+    onrestart restart media
+    onrestart restart surfaceflinger
+    onrestart restart inputflinger
+    onrestart restart drm
     onrestart restart cameraserver
     writepid /dev/cpuset/system-background/tasks
 
+    setenv LD_PRELOAD /system/lib/libselinux_bypass.so
+    # ---------------------------------------------------------------------
+    # [ardbeg] 2026-11-12 补齐 SELinux 域声明，消除 init 域告警
+    # 现象：dmesg 里 `init: Service servicemanager does not have a SELinux domain defined.`
+    # 根因：本机 rootfs 是 ramfs，不支持 TMPFS_XATTR（见
+    #       `restorecon("/init") failed: Operation not supported ...`），
+    #       init 自身停在 u:r:kernel:s0；Service::Start() 的 ComputeContext()
+    #       以 kernel 域为源去查 type_transition（策略里的规则都以
+    #       u:r:init:s0 为源），算出的 scon 与 mycon 相同 -> 打印该 ERROR，
+    #       服务实际也留在 u:r:kernel:s0（已实测 /proc/<pid>/attr/current）。
+    # 修法：显式 seclabel u:r:init:s0，让 init 走 service.cpp 的
+    #       `if (!seclabel_.empty())` 短路分支，不再调用 ComputeContext()。
+    # 安全性：u:r:init:s0 在 /sepolicy 类型表中真实存在（已解析校验）；
+    #       当前 androidboot.selinux=permissive，域变化只记录 avc、不阻断功能；
+    #       11-12 已用同一模式为 sf_hwc_off 补齐并重启验证 PASS。
+    # 边界：本行只消除域告警；若日后切回 enforcing，应改为各服务自身真实域。
+    # 回退：删除本行；批量回退脚本 wb_tmp/restore_seclabel_all.sh。
+    # ---------------------------------------------------------------------
+    seclabel u:r:init:s0
