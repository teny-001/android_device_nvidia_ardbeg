+#   $(TARGET_COPY_OUT_VENDOR)/lib/libwvdrm_L1.so
+#   $(TARGET_COPY_OUT_VENDOR)/lib/libdrmdecrypt.so
+#   $(TARGET_COPY_OUT_VENDOR)/lib/drm/libdrmwvmplugin.so
+#
+# 其他 HAL / 守护进程（缺了对应功能不可用，但能开机）：
+#   proprietary/lib/hw/keystore.tegra.so        keystore HAL，退回 AOSP 默认实现
+#   $(TARGET_COPY_OUT_VENDOR)/lib/hw/thermal.tegra.so   温控 HAL，缺失后没有过热降频策略
+#   $(TARGET_COPY_OUT_VENDOR)/bin/tlk_daemon    TLK 安全世界守护进程
+#   $(TARGET_COPY_OUT_VENDOR)/firmware/maxim_fp35.bin   触摸控制器固件
+#   proprietary/lib/libOTAUpdate.so             OTA 升级辅助库
